# pocketic-py (https://github.com/dfinity/pocketic-py), PocketIC's Python library, in a Python
# environment: its `python3` can `import pocket_ic`. pocketic-py talks to a PocketIC server, which
# is ./pocket-ic.nix, through its REST API. Version 3.1.2 works with PocketIC 16.0.0.
#
# From PyPI, with the packages that it needs and that nixpkgs lacks, or has in a version that does
# not work. To update, take the versions and sha256 digests from https://pypi.org/pypi/<name>/json.
{ python3, fetchPypi }:
let
  python = python3.override {
    self = python;
    packageOverrides = pyself: pysuper: {
      pocket-ic = pyself.buildPythonPackage rec {
        pname = "pocket-ic";
        version = "3.1.2";
        format = "wheel";
        src = fetchPypi {
          pname = "pocket_ic";
          inherit version format;
          dist = "py3";
          python = "py3";
          hash = "sha256-GzKPq7sle0+hq5usDQclRyTRbWhM50yNplJUb9NRplg=";
        };
        dependencies = with pyself; [
          ic-py
          requests
        ];
        pythonImportsCheck = [ "pocket_ic" ];
      };

      # The IC's Python agent, whose Candid pocketic-py uses.
      ic-py = pyself.buildPythonPackage rec {
        pname = "ic-py";
        version = "1.0.1";
        format = "wheel";
        src = fetchPypi {
          pname = "ic_py";
          inherit version format;
          dist = "py3";
          python = "py3";
          hash = "sha256-1yohRontiypkXptakQ9iZGsA4zdaFJGRBZD9Uiiqbps=";
        };
        dependencies = with pyself; [
          antlr4-python3-runtime
          cbor2
          ecdsa
          httpx
          leb128
          mnemonic
          waiter
        ];
        # It asks for mnemonic 0.20 exactly; nixpkgs has 0.21.
        pythonRelaxDeps = [ "mnemonic" ];
      };

      waiter = pyself.buildPythonPackage rec {
        pname = "waiter";
        version = "1.6";
        format = "wheel";
        src = fetchPypi {
          inherit pname version format;
          dist = "py3";
          python = "py3";
          hash = "sha256-HH8FG5PSW3AYhr7KG53hAEhcLqD0+SAG1H+ZJnMtIlk=";
        };
      };

      # ic-py's parser of Candid files, which `import ic` loads, was generated by ANTLR 4.9.3. The
      # runtime of ANTLR 4.10 and later, which nixpkgs has, refuses it: "Could not deserialize ATN
      # with version 3 (expected 4)".
      antlr4-python3-runtime = pyself.buildPythonPackage rec {
        pname = "antlr4-python3-runtime";
        version = "4.9.3";
        pyproject = true;
        src = fetchPypi {
          inherit pname version;
          hash = "sha256-8iRGm0FoKUkCux76gKi/eFXyTJmu+Zy+/BvNPM53iBs=";
        };
        build-system = [ pyself.setuptools ];
      };

      # ic-py imports it for its identities (ic/identity.py), which generate keys and sign calls
      # with it. CVE-2024-23342, for which nixpkgs marks it insecure, is a timing side channel in
      # signing, key generation and ECDH. measure.py does none of these: pocketic-py's calls are
      # anonymous. So this environment, the dev shell's python3 too, is not for signing with
      # ic-py's identities.
      ecdsa = pysuper.ecdsa.overridePythonAttrs (old: {
        meta = old.meta // {
          knownVulnerabilities = [ ];
        };
      });
    };
  };
in
# With pocketic-py's package as `pocket-ic`, for its version.
(python.withPackages (ps: [ ps.pocket-ic ])).overrideAttrs (old: {
  passthru = old.passthru // {
    inherit (python.pkgs) pocket-ic;
  };
})
